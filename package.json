{
  "name": "openteams",
  "version": "1.0.24-140",
  "private": true,
  "bin": {
    "openteams": "npx/openteams-npx/bin/cli.js"
  },
  "files": [
    "npx/openteams-npx/bin/**",
    "npx/openteams-npx/package.json",
    "npx/openteams-npx/dist/**"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "lint": "pnpm run frontend:lint && pnpm run backend:lint",
    "format": "pnpm run backend:format",
    "format:check": "pnpm run backend:format:check",
    "check": "pnpm run frontend:check && pnpm run frontend:test && pnpm run backend:check",
    "frontend:lint": "pnpm -C frontend run lint",
    "frontend:dev": "node scripts/frontend-dev.js",
    "frontend:build": "pnpm -C frontend run build",
    "frontend:preview": "pnpm -C frontend run preview",
    "frontend:clean": "pnpm -C frontend run clean",
    "frontend:check": "pnpm -C frontend run lint",
    "frontend:test": "pnpm -C frontend run test",
    "check-i18n.sh": "bash scripts/check-i18n.sh",
    "backend:lint": "cargo clippy --workspace --all-targets --features qa-mode -- -D warnings",
    "backend:format": "cargo fmt --all",
    "backend:format:check": "cargo fmt --all -- --check",
    "backend:dev": "BACKEND_PORT=$(node scripts/setup-dev-environment.js backend) pnpm run backend:dev:watch",
    "backend:check": "cargo check",
    "backend:dev:watch": "node scripts/backend-dev-watch.js",
    "dev:qa": "export FRONTEND_PORT=$(node scripts/setup-dev-environment.js frontend) && export BACKEND_PORT=$(node scripts/setup-dev-environment.js backend) && export VK_ALLOWED_ORIGINS=\"http://localhost:${FRONTEND_PORT}\" && concurrently \"pnpm run backend:dev:watch:qa\" \"pnpm run frontend:dev\"",
    "generate-types": "cargo run --bin generate_types",
    "generate-types:check": "cargo run --bin generate_types -- --check",
    "prepare-db": "node scripts/prepare-db.js",
    "prepare-db:check": "node scripts/prepare-db.js --check",
    "build:npx": "bash ./local-build.sh",
    "build:npx:alias": "cd npx/openteams-web-npx && pnpm pack",
    "prepack": "pnpm run build:npx",
    "desktop:sync-icons": "node scripts/desktop/sync-icons.js",
    "desktop:dev": "pnpm run desktop:sync-icons && pnpm -C frontend build && node scripts/desktop/prepare-sidecar.js --debug --skip-cli && pnpm tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "pnpm tauri build && node scripts/desktop/style-dmg.mjs --all",
    "desktop:prepare-sidecar": "node scripts/desktop/prepare-sidecar.js --release"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "bundleDependencies": [
    "adm-zip"
  ],
  "devDependencies": {
    "@tauri-apps/cli": "^1.5.0",
    "concurrently": "^8.2.2",
    "pngjs": "^7.0.0",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@10.13.1"
}
